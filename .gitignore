# =============================================================================
# Willemstad-X fork —— 版本控制忽略规则
# -----------------------------------------------------------------------------
# 原则：仓库只跟踪「源码 + 构建产物 + 文档 + 配置」。
#   - src/            源码（唯一真相来源）
#   - theme.css       构建产物，用户直接安装，必须提交
#   - publish.css     构建产物（Publish 冻结轨道），必须提交
#   - archive/        历史产物，仅本地留存，不进版本控制
# =============================================================================

# ---- 归档区：历史版本 CSS 快照、旧 SCSS 源码、过期产物、旧截图 --------------
# old/ 与 V1.9/ 曾分别占用 68MB / 145MB，现已移入此处，只在本地保留。
/archive/

# ---- 依赖 -------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
package-lock.json

# ---- Python（.cursor/skills/verify-willemstad 与其测试） ---------------------
__pycache__/
*.py[cod]

# ---- 构建 / 测试临时目录 ----------------------------------------------------
/.tmp/
.tmp-*/
tmp/

# ---- 构建与检查的临时产物 ---------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
.stylelintcache
*.bak
*.orig
*.rej
*.tsbuildinfo

# ---- 编辑器 / IDE -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---- 操作系统垃圾 -----------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
